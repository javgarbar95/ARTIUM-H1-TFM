{
  "expo": {
    "name": "Artium",
    "slug": "artium-hito-1",
    "version": "0.1.0",
    "scheme": "artium",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "es.artium.tfm.demo"
    },
    "android": {
      "package": "es.artium.tfm.demo",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecciona una imagen para añadirla a tu biblioteca de Artium.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-asset",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
