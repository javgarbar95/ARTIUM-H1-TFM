{
  "name": "artium-hito-1",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src tests scripts --max-warnings=0",
    "test": "tsx --test tests/*.test.ts",
    "check:versions": "expo install --check",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:web": "expo export --platform web --output-dir dist/web",
    "test:e2e": "playwright test",
    "verify:pdf": "tsx scripts/verify-pdf.ts",
    "brand:logo": "node scripts/install-logo.mjs",
    "format": "prettier --write app src tests scripts *.ts *.js *.json *.css"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.2.0",
    "@typescript-eslint/parser": "^8.72.2",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.0",
    "expo-doctor": "^1.21.6",
    "prettier": "^3.9.10",
    "tailwindcss": "~3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24.3.0 <25"
  }
}
